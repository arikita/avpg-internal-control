# Self-hosted env. Copy → .env và điền. (.env đã bị gitignore)

# ===== App =====
APP_ENV=production
APP_BASE_URL=https://dexuat.avpgtech.com
PORT=8787
ENTRA_REDIRECT_PATH=/auth/callback
NO_REPLY_MAILBOX=no-reply@anvietenergy.com
# Shared mailbox nhận hóa đơn NCC (ingest đọc qua Graph Mail.Read). Trống = tắt ingest.
INVOICE_MAILBOX=
VN_TZ_OFFSET_MINUTES=420
# CSV email admin/sysadmin
ADMIN_EMAILS=

# ===== Session (bắt buộc) — sinh chuỗi ngẫu nhiên dài =====
SESSION_SECRET=

# ===== Entra ID (login OIDC) =====
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# ===== Telegram (webhook mode — ingress A) =====
TELEGRAM_BOT_TOKEN=
KSNB_TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ===== Postgres (Phase 2) =====
POSTGRES_USER=ksnb
POSTGRES_PASSWORD=
POSTGRES_DB=avpg
# LƯU Ý: nếu POSTGRES_PASSWORD có ký tự đặc biệt (@ : / # ^ ...), phải URL-encode
# khi nhúng vào DATABASE_URL (vd @ → %40, ^ → %5E). Tránh rắc rối: dùng password chỉ chữ+số.
DATABASE_URL=postgres://ksnb:CHANGEME@postgres:5432/avpg

# ===== LDAP / AD (Phase 4) =====
LDAP_URL=ldaps://DC_FQDN:636
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=

# ===== Cloudflare Tunnel (ingress A) =====
# Token lấy từ CF dashboard → Zero Trust → Tunnels. Ingress hostname trỏ về http://app:8787
CLOUDFLARED_TOKEN=
